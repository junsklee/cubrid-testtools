<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test Reports - CUBRID Builder/Tester</title>
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= Date.now() %>">
</head>
<body>
    <div class="bg-animation"></div>

    <header class="header">
        <div class="logo">
            <div class="logo-icon">BT</div>
            <h1>Test Reports Management</h1>
        </div>
    </header>

    <div class="reports-container">
        <div class="page-header">
            <a href="/" class="back-button">← Back to Dashboard</a>
            <div class="page-title">
                <h2>All Reports</h2>
                <p class="page-subtitle">Manage and filter test execution reports</p>
            </div>
        </div>

        <!-- Filters Toolbar -->
        <div class="filters-toolbar">
            <div class="filters-row">
                <div class="filter-group">
                    <label for="filter-search">Search</label>
                    <input type="text" id="filter-search" placeholder="Search by request ID..." />
                </div>

                <div class="filter-group">
                    <label for="filter-from">From Date</label>
                    <input type="date" id="filter-from" />
                </div>

                <div class="filter-group">
                    <label for="filter-to">To Date</label>
                    <input type="date" id="filter-to" />
                </div>

                <div class="filter-group">
                    <label for="filter-sort">Sort By</label>
                    <select id="filter-sort">
                        <option value="modified-desc">Newest First</option>
                        <option value="modified-asc">Oldest First</option>
                        <option value="id-asc">ID (A-Z)</option>
                        <option value="id-desc">ID (Z-A)</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="filter-pagesize">Per Page</label>
                    <select id="filter-pagesize">
                        <option value="10">10</option>
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

            <div class="filters-actions">
                <button id="btn-apply-filters" class="btn btn-primary">Apply Filters</button>
                <button id="btn-reset-filters" class="btn btn-secondary">Reset</button>
            </div>
        </div>

        <!-- Bulk Actions Toolbar -->
        <div class="bulk-toolbar">
            <div class="bulk-select">
                <input type="checkbox" id="select-all" />
                <label for="select-all">Select All on Page</label>
                <span id="selected-count" class="selected-count">0 selected</span>
            </div>

            <div class="bulk-actions">
                <button id="btn-delete-selected" class="btn btn-danger" disabled>Delete Selected</button>

                <div class="bulk-dropdown">
                    <button id="btn-bulk-menu" class="btn btn-secondary">Bulk Actions ▼</button>
                    <div id="bulk-menu" class="bulk-menu">
                        <button data-action="delete-newest">Delete Newest N</button>
                        <button data-action="delete-oldest">Delete Oldest N</button>
                        <button data-action="delete-daterange">Delete by Date Range</button>
                        <button data-action="keep-last">Keep Last N (Delete Rest)</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading Indicator -->
        <div id="loading" class="loading-indicator" style="display: none;">
            <div class="spinner"></div>
            <p>Loading reports...</p>
        </div>

        <!-- Reports Table -->
        <div class="reports-table-wrapper">
            <table id="reports-table" class="reports-table">
                <thead>
                    <tr>
                        <th width="40">
                            <input type="checkbox" id="th-select-all" />
                        </th>
                        <th>Request ID</th>
                        <th>Date & Time</th>
                        <th>Build Type</th>
                        <th>Run Mode</th>
                        <th>Commits</th>
                        <th>Test Results</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="reports-tbody">
                    <!-- Rows will be populated by JavaScript -->
                </tbody>
            </table>

            <div id="empty-state" class="empty-state" style="display: none;">
                <h3>No Reports Found</h3>
                <p>No test reports match your current filters.</p>
                <p>Try adjusting your search criteria or submit a new build request.</p>
            </div>
        </div>

        <!-- Pagination -->
        <div class="pagination-wrapper">
            <div class="pagination-info">
                <span id="pagination-info-text">Showing 0-0 of 0 reports</span>
            </div>
            <div id="pagination-controls" class="pagination-controls">
                <!-- Pagination buttons will be generated by JavaScript -->
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="modal" class="modal" style="display: none;">
        <div class="modal-content">
            <h3 id="modal-title">Confirm Action</h3>
            <p id="modal-message"></p>
            <div id="modal-preview" class="modal-preview"></div>
            <div class="modal-actions">
                <button id="modal-confirm" class="btn btn-danger">Confirm</button>
                <button id="modal-cancel" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Bulk Action Input Modal -->
    <div id="input-modal" class="modal" style="display: none;">
        <div class="modal-content">
            <h3 id="input-modal-title">Bulk Action</h3>
            <p id="input-modal-message"></p>
            <div class="modal-input-group">
                <label id="input-modal-label" for="input-modal-value"></label>
                <input type="number" id="input-modal-value" min="1" />
            </div>
            <div class="modal-checkbox">
                <input type="checkbox" id="input-modal-dryrun" checked />
                <label for="input-modal-dryrun">Dry run (preview only)</label>
            </div>
            <div class="modal-actions">
                <button id="input-modal-confirm" class="btn btn-primary">Continue</button>
                <button id="input-modal-cancel" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast"></div>

    <script src="/js/reports.js?v=<%= Date.now() %>"></script>
</body>
</html>
