<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CUBRID Builder-Tester Dashboard</title>
    <% const assetVersion = Date.now(); %>
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>">
    <script>
        window.SERVER_CONFIG = {
            builderHost: '<%= config.builder.host %>',
            builderPort: '<%= config.builder.port %>',
            reportPort: '<%= config.server.port %>',
            localIp: '<%= config.server.localIp %>',
            githubDefaultBranch: '<%= config.github.defaultBranch %>'
        };
    </script>
</head>
<body>
    <div class="bg-animation"></div>
    
    <header class="header">
        <div class="logo">
            <div class="logo-icon">BT</div>
            <h1>CUBRID Builder-Tester</h1>
        </div>
        <button class="info-button" onclick="showSystemInfo()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            System Info
        </button>
    </header>

    <div class="container">
        <!-- Request Builder Card -->
        <div class="card">
            <h2 class="card-title">
                <div class="card-title-icon">📤</div>
                Build Test Request
            </h2>

            <!-- Commits Section -->
            <div class="form-group">
                <label class="form-label">Commits</label>
                <div class="commit-selector">
                    <button id="selectModeBtn" class="mode-btn active" onclick="setCommitMode('select')">
                        Browse & Select
                    </button>
                    <button id="manualModeBtn" class="mode-btn" onclick="setCommitMode('manual')">
                        Manual Input
                    </button>
                    <button id="prModeBtn" class="mode-btn" onclick="setCommitMode('pr')">
                        PR Number
                    </button>
                    <button id="customScriptModeBtn" class="mode-btn" onclick="setCommitMode('custom')">
                        Custom Script
                    </button>
                </div>

                <div id="selectCommits" class="commit-section">
                    <div class="commit-controls">
                        <button class="control-btn" onclick="selectAllCommits()">Select All</button>
                        <button class="control-btn" onclick="deselectAllCommits()">Deselect All</button>
                        <span class="commit-counter">Selected: <span id="selectedCount">0</span></span>
                    </div>
                    <div class="commit-list" id="commitList">
                        <div class="spinner"></div>
                    </div>
                    <button class="load-more-btn" id="loadMoreBtn" onclick="loadMoreCommits()" style="display: none;">
                        Load More Commits
                    </button>
                </div>

                <div id="manualCommits" class="commit-section" style="display: none;">
                    <div class="form-group branch-config-group">
                        <label class="form-label" for="cubridBranchInput">
                            CUBRID Branch
                            <span class="info-icon" title="Selects the branch in the CUBRID engine repository. Default: develop.&#10;&#10;Repo: https://github.com/cubrid/cubrid">ⓘ</span>
                        </label>
                        <input type="text" class="form-input" id="cubridBranchInput"
                            value="<%= config.github.defaultBranch %>"
                            placeholder="develop">
                    </div>
                    <textarea class="form-textarea" id="manualCommitInput"
                        placeholder="Enter commit SHAs (one per line or comma-separated)&#10;Example:&#10;568fbb5370f4f1b6149218221d7fe4f9daa59168&#10;b534d0a4f28921c8e590f68f606049e1b643e252"></textarea>
                </div>

                <div id="prCommits" class="commit-section" style="display: none;">
                    <input type="number" class="form-input" id="prNumberInput" min="1" placeholder="Enter PR number (e.g., 6402)">
                    <p class="help-text" style="margin-top: 0.5rem; color: var(--text-secondary);">Build the PR head commit resolved against develop baseline.</p>
                </div>

                <div id="customScriptCommits" class="commit-section" style="display: none;">
                    <div style="margin-bottom: 1rem;">
                        <label class="form-label">
                            Commit SHA or PR Number <span style="color: var(--text-secondary); font-weight: normal;">(Optional)</span>
                            <span class="info-icon" title="If empty, uses the latest commit from the 'develop' branch.">ⓘ</span>
                        </label>
                        <input type="text" class="form-input" id="customScriptCommitInput"
                            placeholder="Enter commit SHA or PR number (e.g., 6ea587e or pr:6402)">
                    </div>

                    <div style="margin-bottom: 1rem;">
                        <label class="form-label">
                                Test Case Path <span style="color: var(--text-secondary); font-weight: normal;">(Optional)</span>
                                <span class="info-icon" title="If provided: Changes to the directory containing the test script, then replaces the script’s contents with your custom script before execution.&#10;&#10; Complete this section if your custom script depends on additional files (e.g., .answer, .sql) located in the test case directory.">ⓘ</span>
                        </label>
                        <input type="text" class="form-input" id="customScriptTestPath"
                            placeholder="Enter test case path (e.g., shell/_36_damson/cbrd_22637/cases/cbrd_22637.sh)">
                    </div>

                    <div style="margin-bottom: 1rem;">
                        <label class="form-label">
                            Attach Files <span style="color: var(--text-secondary); font-weight: normal;">(Optional)</span>
                            <span class="info-icon" title="Files will be created/overwritten next to the executed custom script.&#10;&#10;If Test Case Path is provided, files go into that directory. Otherwise, files go into the default custom script working directory.&#10;&#10;Max 20 files, 5MB total. Paths are relative (no leading '/', no '..').">ⓘ</span>
                        </label>
                        <input type="file" id="customScriptAttachments" class="file-input-hidden" multiple>
                        <div class="file-upload-row">
                            <label for="customScriptAttachments" class="control-btn file-upload-btn">Choose Files</label>
                            <span id="customScriptAttachmentsSummary" class="file-upload-summary">No files selected.</span>
                        </div>
                        <div id="customScriptAttachmentsList" class="file-upload-list"></div>
                    </div>

                    <div>
                        <label class="form-label">
                            Custom Shell Script Contents <span style="color: #ff6b6b; font-weight: normal;">(Required)</span>
                            <span class="info-icon" title="This script will be executed instead of a standard test. Environment variables (CUBRID, CTP_HOME, PATH, LD_LIBRARY_PATH) will be set up automatically.">ⓘ</span>
                        </label>
                        <textarea class="form-textarea" id="customScriptContent"
                            rows="20"
                            style="font-family: 'Courier New', monospace; font-size: 0.875rem; background: #1e1e1e; color: #d4d4d4;"
                            placeholder="# Paste your script here (example below):&#10;&#10;#!/bin/sh&#10;. $init_path/init.sh&#10;init test&#10;&#10;dbname=cbrd_XXXXX&#10;cubrid_createdb $dbname&#10;cubrid server start $dbname&#10;&#10;# Test contents...&#10;&#10;cubrid server stop $dbname&#10;cubrid deletedb $dbname&#10;&#10;finish"></textarea>
                    </div>
                </div>

            </div>

            <!-- Build-only Upload -->
            <div class="form-group" id="buildOnlySection">
                <div class="build-only-header">
                    <label class="form-label">
                        Build-only Upload
                        <span class="info-icon" title="Builds selected commit(s) locally and uploads cubrid_<sha>.tar.gz via SFTP.">ⓘ</span>
                    </label>
                </div>
                <label class="toggle-switch" for="buildOnlyToggle">
                    <input type="checkbox" id="buildOnlyToggle">
                    <span class="toggle-slider"></span>
                    <span class="toggle-text" style="font-weight: normal;">Build only (skip tests)</span>
                </label>
                <div id="buildOnlyFields" class="build-only-fields" style="display: none;">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="buildUploadHost">
                                Destination Host <span class="required">*</span>
                                <span class="info-icon" title="SFTP server hostname or IP (Required)">ⓘ</span>
                            </label>
                            <input type="text" class="form-input" id="buildUploadHost" placeholder="e.g., 192.168.1.50">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="buildUploadPort">
                                Destination Port
                                <span class="info-icon" title="SFTP port (Optional)&#10;Default: 22">ⓘ</span>
                            </label>
                            <input type="number" class="form-input" id="buildUploadPort" placeholder="22" min="1" max="65535">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="buildUploadUser">
                                Username <span class="required">*</span>
                                <span class="info-icon" title="SFTP username (Required)">ⓘ</span>
                            </label>
                            <input type="text" class="form-input" id="buildUploadUser" placeholder="e.g., username">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="buildUploadPassword">
                                Password <span class="required">*</span>
                                <span class="info-icon" title="SFTP password (Required)&#10;Not stored or shown in logs">ⓘ</span>
                            </label>
                            <input type="password" class="form-input" id="buildUploadPassword" placeholder="e.g., password">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="buildUploadRemoteDir">
                            Destination Directory
                            <span class="info-icon" title="Remote directory to upload into (Optional)&#10;Default: ~ ($HOME)">ⓘ</span>
                        </label>
                        <input type="text" class="form-input" id="buildUploadRemoteDir" placeholder="~">
                    </div>
                </div>
            </div>

            <div class="form-group" id="shellTcBranchSection" style="display: none;">
                <label class="form-label" for="shellTcBranchInput">
                    TEST CASES BRANCH
                    <span class="info-icon" title="Selects the branch in the TC repository cubrid-testcases-private-ex. Default: develop.&#10;&#10;Repo: https://github.com/CUBRID/cubrid-testcases-private-ex">ⓘ</span>
                </label>
                <input type="text" class="form-input" id="shellTcBranchInput"
                    value="develop"
                    placeholder="develop">
            </div>

            <!-- Test Type Section -->
            <div class="form-group" id="testTypeSection">
                <label class="form-label" for="testTypeSelect">
                    Test Type
                    <span class="info-icon" title="Shell: shell test cases (.sh), e.g. shell/.../cases/<name>.sh.&#10;SQL: SQL test cases (.sql) executed by CTP, e.g. sql/.../cases/<name>.sql.">ⓘ</span>
                </label>
                <select class="form-select" id="testTypeSelect" onchange="onTestTypeChange()">
                    <option value="shell" selected>Shell</option>
                    <option value="sql">SQL</option>
                </select>
            </div>

            <!-- Test Cases Section -->
            <div class="form-group" id="testCasesSection">
                <label class="form-label" for="testsInput" id="testsInputLabel">Test Cases</label>
                <textarea class="form-textarea" id="testsInput"
                    placeholder="Enter test case paths (one per line)&#10;Example:&#10;shell/_05_addition/cubridsus1961/cases/cubridsus1961.sh"></textarea>
            </div>

            <!-- Worker Configuration -->
            <div class="form-group" id="workerSection">
                <label class="form-label">Worker Nodes</label>
                <div class="worker-list" id="workerList">
                    <div class="worker-item">
                        <span class="worker-ip">localhost</span>
                        <button class="remove-worker-btn" onclick="removeWorker(this)" style="display: none;">×</button>
                    </div>
                </div>
                <div class="worker-input-group">
                    <input type="text" class="form-input add-worker-input" id="newWorkerInput" 
                        placeholder="Enter worker IP or hostname">
                    <button class="control-btn" onclick="addWorker()">Add Worker</button>
                </div>
            </div>

            <!-- Build Configuration -->
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="buildType">Build Type</label>
                    <select class="form-select" id="buildType">
                        <option value="release" selected>Release</option>
                        <option value="debug">Debug</option>
                    </select>
                </div>
                
                <div class="form-group" id="callbackUrlGroup">
                    <label class="form-label" for="callbackUrl">Callback URL</label>
                    <input type="text" class="form-input" id="callbackUrl" 
                        value="http://localhost:<%= config.server.port %>/callback">
                </div>
            </div>

            <!-- Advanced Configuration -->
            <div class="advanced-config">
                <button class="toggle-advanced-btn" onclick="toggleAdvanced()">
                    <span>⚙️ Advanced Configuration</span>
                    <span class="toggle-icon">▼</span>
                </button>
                
                <div class="advanced-panel" id="advancedPanel" style="display: none;">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="timeout">Timeout (seconds)</label>
                            <input type="number" class="form-input" id="timeout" value="7200">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="minRuns">Min Runs</label>
                            <input type="number" class="form-input" id="minRuns" value="1" min="1">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="maxRuns">Max Runs</label>
                            <input type="number" class="form-input" id="maxRuns" value="2" min="1">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="runMode">Run Mode</label>
                        <select class="form-select" id="runMode">
                            <option value="until-pass">Until Pass</option>
                            <option value="until-fail">Until Fail</option>
                            <option value="fixed-runs">Fixed Runs</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Build Mode</label>
                        <div class="baseline-info" id="baselineInfo">
                            <div class="baseline-options">
                            <label class="baseline-option" for="buildModeCheckout">
                                <span class="baseline-choice">
                                    <input type="radio" id="buildModeCheckout" name="buildMode" class="baseline-radio" value="checkout" checked>
                                    <span class="baseline-label">Checkout (default)</span>
                                    <span class="info-icon" title="Build each commit by direct checkout (no baseline cherry-pick).">ⓘ</span>
                                </span>
                            </label>
                            <label class="baseline-option" for="buildModeBaseline">
                                <span class="baseline-choice">
                                    <input type="radio" id="buildModeBaseline" name="buildMode" class="baseline-radio" value="baseline_cherrypick">
                                    <span class="baseline-label">Baseline cherry-pick</span>
                                    <span class="info-icon" title="Builds each commit by cherry-picking on top of the baseline, which is the earliest commit's parent.&#10;Warning: Commits are not independent variables; later commits depend on earlier changes, so results can be unstable or non-linear.">ⓘ</span>
                                </span>
                            </label>
                            </div>
                            <span class="baseline-value" id="baselineSha">Select commits to determine baseline.</span>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="envVars">Environment Variables (JSON)</label>
                        <textarea class="form-textarea" id="envVars" 
                            placeholder='{"VARIABLE_NAME": "value", "ANOTHER_VAR": "value2"}'></textarea>
                    </div>
                </div>
            </div>

            <button class="submit-button" id="submitButton" onclick="submitBuildRequest()">
                Send Build Request
            </button>

            <div id="responseDisplay" style="display: none; margin-top: 1.5rem; margin-bottom: 0;">
                <h3>Response:</h3>
                <div class="response-display" id="responseContent"></div>
            </div>
        </div>

        <!-- Build Request Queue Card -->
        <div class="card">
            <h2 class="card-title">
                <div class="card-title-icon">🧾</div>
                Build Request Queue
            </h2>
            <div style="color: var(--text-secondary);" id="build-queue-summary">Loading...</div>
            <div id="build-queue-items" class="queue-list"></div>
        </div>

        <!-- Build Status Monitor Card -->
        <div class="card">
            <h2 class="card-title">
                <div class="card-title-icon">📊</div>
                Build Status Monitor
            </h2>
            
            <div class="status-controls" style="margin-bottom: 1rem;">
                <button class="control-btn" onclick="window.refreshBuildStatus && window.refreshBuildStatus()" 
                        id="refreshStatusBtn" style="display: none;">
                    🔄 Refresh Status
                </button>
                <button class="control-btn" onclick="window.toggleBuilderLog && window.toggleBuilderLog()" 
                        id="tailBuilderLogBtn" style="display: none; margin-left: 0.5rem;">
                    📋 View Builder Log
                </button>
            </div>

            <div id="statusMonitorHint" style="display: none; margin-bottom: 1rem; color: var(--text-secondary); font-size: 0.9rem;"></div>
            
            <div id="statusMonitor">
                <p style="color: var(--text-secondary);">No active builds. Submit a request to start monitoring.</p>
            </div>

            <!-- Log tail container (initially hidden) -->
            <div id="logTailContainer" style="display: none; margin-top: 1rem; border-top: 1px solid #444; padding-top: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <h3 style="margin: 0; font-size: 1rem; color: var(--text-secondary);" id="builderLogTitle">Builder Log</h3>
                    <div style="display: flex; gap: 0.5rem;">
                        <button class="control-btn" onclick="clearBuilderLog()" style="padding: 2px 8px; font-size: 0.8rem;">Clear</button>
                        <button class="control-btn" onclick="window.toggleBuilderLog()" style="padding: 2px 8px; font-size: 0.8rem;">Close</button>
                    </div>
                </div>
                <pre id="builderLogArea" style="background: #1e1e1e; color: #d4d4d4; padding: 1rem; border-radius: 4px; max-height: 400px; overflow-y: auto; font-family: 'Consolas', 'Monaco', monospace; font-size: 0.85rem; line-height: 1.4; white-space: pre-wrap; border: 1px solid #333;"></pre>
            </div>
        </div>

        <!-- Recent Reports Card -->
        <div class="card">
            <h2 class="card-title">
                <div class="card-title-icon">📋</div>
                Recent Test Reports
            </h2>
            
            <div class="reports-section">
                <div class="reports-controls">
                    <button class="control-btn" onclick="refreshReports()">Refresh</button>
                    <button class="control-btn" onclick="viewAllReports()">View All Reports</button>
                </div>
                
                <div id="recentReports">
                    <div class="spinner"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Info Modal -->
    <div class="modal" id="systemInfoModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">System Information</h2>
                <div class="modal-close" onclick="closeSystemInfo()">×</div>
            </div>
            
            <div class="info-section">
                <h3 class="info-title">Builder Configuration</h3>
                <div class="info-grid" id="builderInfo">
                    <div class="spinner"></div>
                </div>
            </div>

            <div class="info-section">
                <h3 class="info-title">Tester Configuration</h3>
                <div class="form-group">
                    <label class="form-label">Tester IP Address</label>
                    <input type="text" class="form-input" id="testerIp" 
                        placeholder="Enter tester IP to check status">
                    <button class="control-btn" style="margin-top: 0.5rem;" 
                        onclick="checkTesterStatus()">Check Status</button>
                </div>
                <div class="info-grid" id="testerInfo" style="margin-top: 1rem;">
                    <p style="color: var(--text-secondary);">Enter tester IP to view configuration</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="/js/dashboard.js?v=<%= assetVersion %>"></script>
</body>
</html>
