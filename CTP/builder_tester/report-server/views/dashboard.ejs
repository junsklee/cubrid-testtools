<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CUBRID Builder-Tester Dashboard</title>
    <% const assetVersion = Date.now(); %>
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= assetVersion %>">
    <script>
        window.SERVER_CONFIG = {
            builderHost: '<%= config.builder.host %>',
            builderPort: '<%= config.builder.port %>',
            reportPort: '<%= config.server.port %>',
            localIp: '<%= config.server.localIp %>',
            githubDefaultBranch: '<%= config.github.defaultBranch %>'
        };
    </script>
</head>
<body>
    <header class="header">
        <div class="logo">
            <h1>CUBRID Builder-Tester</h1>
        </div>
        <button class="info-button" onclick="showSystemInfo()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            System Info
        </button>
    </header>

    <div class="container">

        <div class="dash-grid">
            <div class="dash-col">
        <!-- Request Builder Card -->
        <div class="card">
            <h2 class="card-title">
                <div class="card-title-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg></div>
                Build Test Request
            </h2>

            <!-- Build Source: build commits from source, or test a published official build as is -->
            <div class="form-group">
                <label class="form-label" id="buildSourceLabel">CUBRID Build</label>
                <div class="source-picker" role="radiogroup" aria-labelledby="buildSourceLabel">
                    <label class="source-option" for="buildSourceSource">
                        <input type="radio" name="buildSource" id="buildSourceSource" value="source" autocomplete="off" checked>
                        <span class="source-option-body">
                            <span class="source-option-title">Build from source</span>
                            <span class="source-option-desc">Commits, a PR, or a custom script, built by the Builder</span>
                        </span>
                    </label>
                    <label class="source-option" for="buildSourceOfficial">
                        <input type="radio" name="buildSource" id="buildSourceOfficial" value="official" autocomplete="off">
                        <span class="source-option-body">
                            <span class="source-option-title">Official build</span>
                            <span class="source-option-desc">A published build from the build store, tested as is</span>
                        </span>
                    </label>
                </div>

                <div id="sourceBuildPanel">
                <div class="commit-selector">
                    <button id="selectModeBtn" class="mode-btn active" onclick="setCommitMode('select')">
                        Browse & Select
                    </button>
                    <button id="manualModeBtn" class="mode-btn" onclick="setCommitMode('manual')">
                        Manual Input
                    </button>
                    <button id="prModeBtn" class="mode-btn" onclick="setCommitMode('pr')">
                        PR Number
                    </button>
                    <button id="customScriptModeBtn" class="mode-btn" onclick="setCommitMode('custom')">
                        Custom Script
                    </button>
                </div>

                <div id="selectCommits" class="commit-section">
                    <div class="commit-controls">
                        <button class="control-btn" onclick="selectAllCommits()">Select All</button>
                        <button class="control-btn" onclick="deselectAllCommits()">Deselect All</button>
                        <span class="commit-counter">Selected: <span id="selectedCount">0</span></span>
                    </div>
                    <div class="commit-list" id="commitList">
                        <div class="spinner"></div>
                    </div>
                    <button class="load-more-btn" id="loadMoreBtn" onclick="loadMoreCommits()" style="display: none;">
                        Load More Commits
                    </button>
                </div>

                <div id="manualCommits" class="commit-section" style="display: none;">
                    <div class="form-group branch-config-group">
                        <label class="form-label" for="cubridBranchInput">
                            CUBRID Branch
                            <span class="info-icon" title="Selects the branch in the CUBRID engine repository. Default: develop.&#10;&#10;Repo: https://github.com/cubrid/cubrid"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                        </label>
                        <input type="text" class="form-input" id="cubridBranchInput"
                            value="<%= config.github.defaultBranch %>"
                            placeholder="develop">
                    </div>
                    <label class="form-label" for="manualCommitInput" style="margin-top: 1rem;">
                        Commit SHAs <span style="color: var(--text-secondary); font-weight: normal;">(Optional)</span>
                        <span class="info-icon" title="If empty, builds the latest commit on the selected CUBRID branch.&#10;&#10;Otherwise enter commit SHAs, one per line or comma-separated."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                    </label>
                    <textarea class="form-textarea" id="manualCommitInput"
                        placeholder="Enter commit SHAs (one per line or comma-separated)&#10;Leave empty to build the latest commit on the selected CUBRID branch&#10;Example:&#10;568fbb5370f4f1b6149218221d7fe4f9daa59168&#10;b534d0a4f28921c8e590f68f606049e1b643e252"></textarea>
                </div>

                <div id="prCommits" class="commit-section" style="display: none;">
                    <input type="number" class="form-input" id="prNumberInput" min="1" placeholder="Enter PR number (e.g., 6402)">
                    <p class="help-text" style="margin-top: 0.5rem; color: var(--text-secondary);">Build the PR head commit resolved against develop baseline.</p>
                </div>

                <div id="customScriptCommits" class="commit-section" style="display: none;">
                    <div style="margin-bottom: 1rem;">
                        <label class="form-label">
                            Commit SHA or PR Number <span style="color: var(--text-secondary); font-weight: normal;">(Optional)</span>
                            <span class="info-icon" title="If empty, uses the latest commit from the 'develop' branch."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                        </label>
                        <input type="text" class="form-input" id="customScriptCommitInput"
                            placeholder="Enter commit SHA or PR number (e.g., 6ea587e or pr:6402)">
                    </div>

                    <!-- Shell custom-script fields (Test Type = Shell) -->
                    <div id="customShellFields">
                        <div style="margin-bottom: 1rem;">
                            <label class="form-label">
                                    Test Case Path <span style="color: var(--text-secondary); font-weight: normal;">(Optional)</span>
                                    <span class="info-icon" title="If provided: Changes to the directory containing the test script, then replaces the script’s contents with your custom script before execution.&#10;&#10; Complete this section if your custom script depends on additional files (e.g., .answer, .sql) located in the test case directory."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <input type="text" class="form-input" id="customScriptTestPath"
                                placeholder="Enter test case path (e.g., shell/_36_damson/cbrd_22637/cases/cbrd_22637.sh)">
                        </div>

                        <div style="margin-bottom: 1rem;">
                            <label class="form-label">
                                Attach Files <span style="color: var(--text-secondary); font-weight: normal;">(Optional)</span>
                                <span class="info-icon" title="Files will be created/overwritten next to the executed custom script.&#10;&#10;If Test Case Path is provided, files go into that directory. Otherwise, files go into the default custom script working directory.&#10;&#10;Max 20 files, 5MB total. Paths are relative (no leading '/', no '..')."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <input type="file" id="customScriptAttachments" class="file-input-hidden" multiple>
                            <div class="file-upload-row">
                                <label for="customScriptAttachments" class="control-btn file-upload-btn">Choose Files</label>
                                <span id="customScriptAttachmentsSummary" class="file-upload-summary">No files selected.</span>
                            </div>
                            <div id="customScriptAttachmentsList" class="file-upload-list"></div>
                        </div>

                        <div>
                            <label class="form-label">
                                Custom Shell Script Contents <span style="color: #7a1230; font-weight: normal;">(Required)</span>
                                <span class="info-icon" title="This script will be executed instead of a standard test. Environment variables (CUBRID, CTP_HOME, PATH, LD_LIBRARY_PATH) will be set up automatically."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <textarea class="form-textarea" id="customScriptContent"
                                rows="20"
                                style="font-family: 'Courier New', monospace; font-size: 0.875rem; background: #f6f8fa; color: #1f2937;"
                                placeholder="# Paste your script here (example below):&#10;&#10;#!/bin/sh&#10;. $init_path/init.sh&#10;init test&#10;&#10;dbname=cbrd_XXXXX&#10;cubrid_createdb $dbname&#10;cubrid server start $dbname&#10;&#10;# Test contents...&#10;&#10;cubrid server stop $dbname&#10;cubrid deletedb $dbname&#10;&#10;finish"></textarea>
                        </div>
                    </div>

                    <!-- SQL custom-case fields (Test Type = SQL) -->
                    <div id="customSqlFields" style="display: none;">
                        <div style="margin-bottom: 1rem;">
                            <label class="form-label">
                                SQL Script Contents <span style="color: #7a1230; font-weight: normal;">(Required)</span>
                                <span class="info-icon" title="An ad-hoc SQL test case, run by CTP's ConsoleAgent against a freshly provisioned 'basic' database in a Docker container. Same format as a cubrid-testcases .sql case (statements separated by ';', CTP directives like --+ holdcas on / --@queryplan supported)."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <textarea class="form-textarea" id="customSqlScriptContent"
                                rows="14"
                                style="font-family: 'Courier New', monospace; font-size: 0.875rem; background: #f6f8fa; color: #1f2937;"
                                placeholder="-- Paste your SQL case here (example below):&#10;&#10;create table t1(a int, b varchar(10));&#10;insert into t1 values (1, 'a'), (2, 'b');&#10;select * from t1 order by a;&#10;drop table t1;"></textarea>
                        </div>

                        <div>
                            <label class="form-label">
                                Expected Answer Contents <span style="color: #7a1230; font-weight: normal;">(Required)</span>
                                <span class="info-icon" title="The expected output (the .answer file CTP compares against). Copy it from a known-good run, or from the matching answers/&lt;name&gt;.answer in cubrid-testcases. Each statement's output is delimited by a line of '=' characters; comparison ignores newline differences."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <textarea class="form-textarea" id="customSqlAnswerContent"
                                rows="14"
                                style="font-family: 'Courier New', monospace; font-size: 0.875rem; background: #f6f8fa; color: #1f2937;"
                                placeholder="===================================================&#10;0&#10;===================================================&#10;2&#10;===================================================&#10;a                   b&#10;1  a&#10;2  b"></textarea>
                        </div>
                    </div>
                </div>
                </div><!-- /sourceBuildPanel -->

                <!-- Official builds of the build store, newest first; several may be selected to compare -->
                <div id="officialBuildPanel" style="display: none;">
                    <div class="series-picker" id="officialSeriesPicker" role="radiogroup" aria-label="Release line"></div>
                    <div class="official-toolbar">
                        <input type="search" class="form-input official-filter" id="officialBuildFilter"
                            placeholder="Filter by version or commit" autocomplete="off" aria-label="Filter official builds">
                        <span class="commit-counter">Selected: <span id="officialSelectedCount">0</span></span>
                        <button type="button" class="control-btn" id="officialClearBtn" onclick="clearOfficialBuilds()">Clear</button>
                    </div>
                    <div class="official-selected" id="officialSelectedChips" aria-live="polite"></div>
                    <div class="commit-list official-list" id="officialBuildList" role="listbox" aria-multiselectable="true" aria-label="Official builds">
                        <div class="spinner"></div>
                    </div>
                    <p class="help-text official-help" id="officialBuildHelp">
                        Testers download <code>drop/CUBRID-&lt;version&gt;-Linux.x86_64.tar.gz</code> (Build Type Debug: <code>-debug</code>)
                        from the <a id="officialStoreLink" href="#" target="_blank" rel="noopener noreferrer">build store</a>. Nothing is built.
                    </p>
                </div>

            </div>

            <!-- Build-only Upload -->
            <div class="form-group" id="buildOnlySection">
                <div class="build-only-header">
                    <label class="form-label">
                        Build-only Upload
                        <span class="info-icon" title="Builds selected commit(s) locally and uploads cubrid_<sha>.tar.gz via SFTP."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                    </label>
                </div>
                <label class="toggle-switch" for="buildOnlyToggle">
                    <input type="checkbox" id="buildOnlyToggle">
                    <span class="toggle-slider"></span>
                    <span class="toggle-text" style="font-weight: normal;">Build only (skip tests)</span>
                </label>
                <div id="buildOnlyFields" class="build-only-fields" style="display: none;">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="buildUploadHost">
                                Destination Host <span class="required">*</span>
                                <span class="info-icon" title="SFTP server hostname or IP (Required)"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <input type="text" class="form-input" id="buildUploadHost" placeholder="e.g., 192.168.1.50">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="buildUploadPort">
                                Destination Port
                                <span class="info-icon" title="SFTP port (Optional)&#10;Default: 22"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <input type="number" class="form-input" id="buildUploadPort" placeholder="22" min="1" max="65535">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="buildUploadUser">
                                Username <span class="required">*</span>
                                <span class="info-icon" title="SFTP username (Required)"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <input type="text" class="form-input" id="buildUploadUser" placeholder="e.g., username">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="buildUploadPassword">
                                Password <span class="required">*</span>
                                <span class="info-icon" title="SFTP password (Required)&#10;Not stored or shown in logs"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                            </label>
                            <input type="password" class="form-input" id="buildUploadPassword" placeholder="e.g., password">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="buildUploadRemoteDir">
                            Destination Directory
                            <span class="info-icon" title="Remote directory to upload into (Optional)&#10;Default: ~ ($HOME)"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                        </label>
                        <input type="text" class="form-input" id="buildUploadRemoteDir" placeholder="~">
                    </div>
                </div>
            </div>

            <!-- Test Type Section -->
            <div class="form-group" id="testTypeSection">
                <label class="form-label" for="testTypeSelect">
                    Test Type
                    <span class="info-icon" title="Shell: shell test cases (.sh), e.g. shell/.../cases/<name>.sh.&#10;SQL: SQL test cases (.sql) executed by CTP, e.g. sql/.../cases/<name>.sql."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                </label>
                <select class="form-select" id="testTypeSelect" autocomplete="off" onchange="onTestTypeChange()">
                    <option value="shell" selected>Shell</option>
                    <option value="sql">SQL</option>
                </select>
            </div>

            <div class="form-group" id="tcBranchSection" style="display: none;">
                <label class="form-label" for="tcBranchInput">
                    TEST CASES BRANCH
                    <span class="info-icon" id="tcBranchInfoIcon" title="Selects the branch in the TC repository cubrid-testcases-private-ex. Default: develop.&#10;&#10;Repo: https://github.com/CUBRID/cubrid-testcases-private-ex"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                </label>
                <input type="text" class="form-input" id="tcBranchInput"
                    value="develop"
                    autocomplete="off"
                    placeholder="develop">
                <p class="help-text" id="tcBranchHint" style="display: none;"></p>
            </div>

            <!-- Test Cases Section -->
            <div class="form-group" id="testCasesSection">
                <label class="form-label" for="testsInput" id="testsInputLabel">Test Cases</label>
                <div id="sqlFullSuiteRow" class="full-suite-row" style="display: none;">
                    <label class="toggle-switch" for="sqlFullSuiteToggle">
                        <input type="checkbox" id="sqlFullSuiteToggle" autocomplete="off">
                        <span class="toggle-slider"></span>
                        <span class="toggle-text" style="font-weight: normal;">Run the full SQL suite</span>
                    </label>
                    <span class="info-icon" title="Runs every SQL case of the SQL testcases branch: all sql/**/cases/*.sql of cubrid-testcases (about 17,700 on develop), listed at the branch head when the request starts."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                </div>
                <p class="help-text full-suite-note" id="sqlFullSuiteNote" style="display: none;"></p>
                <textarea class="form-textarea" id="testsInput"
                    placeholder="Enter test case paths (one per line)&#10;Example:&#10;shell/_05_addition/cubridsus1961/cases/cubridsus1961.sh"></textarea>
            </div>

            <!-- Build Configuration -->
            <div class="form-group">
                <label class="form-label" for="buildType">Build Type</label>
                <select class="form-select" id="buildType">
                    <option value="release" selected>Release</option>
                    <option value="debug">Debug</option>
                </select>
            </div>

            <!-- Advanced Configuration -->
            <div class="advanced-config">
                <button class="toggle-advanced-btn" onclick="toggleAdvanced()">
                    <span>⚙️ Advanced Configuration</span>
                    <span class="toggle-icon">▼</span>
                </button>
                
                <div class="advanced-panel" id="advancedPanel" style="display: none;">
                    <div class="form-row form-row-inline">
                        <div class="form-group">
                            <label class="form-label" for="timeout">Timeout (seconds)</label>
                            <input type="number" class="form-input" id="timeout" value="7200">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="minRuns">Min Runs</label>
                            <input type="number" class="form-input" id="minRuns" value="1" min="1">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="maxRuns">Max Runs</label>
                            <input type="number" class="form-input" id="maxRuns" value="2" min="1">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="runMode">Run Mode</label>
                        <select class="form-select" id="runMode">
                            <option value="until-pass">Until Pass</option>
                            <option value="until-fail">Until Fail</option>
                            <option value="fixed-runs">Fixed Runs</option>
                        </select>
                    </div>

                    <!-- Execution mode decides whether the worker list applies (Docker) or VMs run the cases -->
                    <div class="form-group">
                        <label class="form-label">Execution Mode</label>
                        <div class="baseline-info" id="executionModeInfo">
                            <div class="baseline-options">
                            <label class="baseline-option" for="executionModeDocker">
                                <span class="baseline-choice">
                                    <input type="radio" id="executionModeDocker" name="executionMode" class="baseline-radio" value="docker" checked>
                                    <span class="baseline-label">Docker (default)</span>
                                    <span class="info-icon" title="Runs each case in a Docker container on the worker nodes, several cases in parallel."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                                </span>
                            </label>
                            <label class="baseline-option" for="executionModeVm">
                                <span class="baseline-choice">
                                    <input type="radio" id="executionModeVm" name="executionMode" class="baseline-radio" value="vm">
                                    <span class="baseline-label">VM</span>
                                    <span class="info-icon" title="Runs cases one at a time on each dedicated QA VM tester listed below, with the VM's own CTP, the way QAHome regression does. Shell: process reset, conf restore, core and fatal-error checks. SQL: the VM's CTP SQL tool and SQL conf.&#10;Starts from the VM testers configured on the Builder (vm_tester_nodes); add or remove VM testers below."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                                </span>
                            </label>
                            <label class="baseline-option" for="executionModeConsumer">
                                <span class="baseline-choice">
                                    <input type="radio" id="executionModeConsumer" name="executionMode" class="baseline-radio" value="consumer">
                                    <span class="baseline-label">VM (regression)</span>
                                    <span class="info-icon" title="Runs shell or SQL cases like VM mode, on the QAHome regression VMs while they are idle: the request waits in the Builder-Tester queue next to the regression queues, and each VM that takes it runs cases one at a time until none are left.&#10;Cases may wait while the VMs run regression."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                                </span>
                            </label>
                            </div>
                            <span class="baseline-value" id="executionModeNote" style="flex-basis: 100%;">Cases run in Docker containers on the worker nodes.</span>
                        </div>
                    </div>

                    <!-- Worker Configuration -->
                    <!-- VM mode: the VM testers (execution_mode=vm) the cases run on -->
                    <div class="form-group" id="vmTesterSection" style="display: none;">
                        <label class="form-label">VM Testers</label>
                        <div class="worker-list" id="vmTesterList"></div>
                        <div class="worker-input-group">
                            <input type="text" class="form-input add-worker-input" id="newVmTesterInput"
                                placeholder="VM tester host:port (execution_mode=vm)">
                            <button class="control-btn" onclick="addVmTester()">Add VM Tester</button>
                        </div>
                    </div>

                    <div class="form-group" id="workerSection">
                        <label class="form-label">Worker Nodes</label>
                        <div class="worker-list" id="workerList">
                            <div class="worker-item">
                                <span class="worker-ip">localhost</span>
                                <button class="remove-worker-btn" onclick="removeWorker(this)" style="display: none;">×</button>
                            </div>
                        </div>
                        <div class="worker-input-group">
                            <input type="text" class="form-input add-worker-input" id="newWorkerInput" 
                                placeholder="Enter worker IP or hostname">
                            <button class="control-btn" onclick="addWorker()">Add Worker</button>
                        </div>
                    </div>

                    <div class="form-group" id="buildModeSection">
                        <label class="form-label">Build Mode</label>
                        <div class="baseline-info" id="baselineInfo">
                            <div class="baseline-options">
                            <label class="baseline-option" for="buildModeCheckout">
                                <span class="baseline-choice">
                                    <input type="radio" id="buildModeCheckout" name="buildMode" class="baseline-radio" value="checkout" checked>
                                    <span class="baseline-label">Checkout (default)</span>
                                    <span class="info-icon" title="Build each commit by direct checkout (no baseline cherry-pick)."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                                </span>
                            </label>
                            <label class="baseline-option" for="buildModeBaseline">
                                <span class="baseline-choice">
                                    <input type="radio" id="buildModeBaseline" name="buildMode" class="baseline-radio" value="baseline_cherrypick">
                                    <span class="baseline-label">Baseline cherry-pick</span>
                                    <span class="info-icon" title="Builds each commit by cherry-picking on top of the baseline, which is the earliest commit's parent.&#10;Warning: Commits are not independent variables; later commits depend on earlier changes, so results can be unstable or non-linear."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                                </span>
                            </label>
                            </div>
                            <span class="baseline-value" id="baselineSha">Select commits to determine baseline.</span>
                        </div>
                    </div>
                    
                    <div class="form-group" id="reuseArtifactsSection">
                        <label class="form-label">
                            Re-use Artifacts
                            <span class="info-icon" title="Reuse the previous build's workspace instead of cloning fresh, which skips rebuilding the 3rdparty libraries and recompiles only what changed.&#10;Off by default: it trades per-build isolation for speed."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                        </label>
                        <label class="toggle-switch" for="reuseArtifactsToggle">
                            <input type="checkbox" id="reuseArtifactsToggle">
                            <span class="toggle-slider"></span>
                            <span class="toggle-text" style="font-weight: normal;">Reuse the previous build workspace (faster)</span>
                        </label>
                        <div id="reuseArtifactsWarning" style="display: none; margin-top: 0.5rem; padding: 0.6rem 0.75rem; border-left: 3px solid var(--warning); background: rgba(191, 132, 0, 0.08); font-size: 0.85rem; line-height: 1.45;">
                            <strong>This build will not start from a clean checkout.</strong>
                            It reuses artifacts from the previous build, so a result can in principle be
                            affected by what was built before it. Prefer a clean build when a result is
                            surprising, or when comparing commits against each other.
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="envVars">Environment Variables (JSON)</label>
                        <textarea class="form-textarea" id="envVars" 
                            placeholder='{"VARIABLE_NAME": "value", "ANOTHER_VAR": "value2"}'></textarea>
                    </div>

                    <div class="form-group" id="callbackUrlGroup">
                        <label class="form-label" for="callbackUrl">
                            Callback URL
                            <span class="info-icon" title="Where the test report is POSTed when the run finishes. Default: this report server's /callback endpoint."><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M8 7.3v4.2" stroke-linecap="round"/><circle cx="8" cy="4.5" r="0.95" fill="currentColor" stroke="none"/></svg></span>
                        </label>
                        <input type="text" class="form-input" id="callbackUrl" 
                            value="http://localhost:<%= config.server.port %>/callback">
                    </div>
                </div>
            </div>

            <button class="submit-button" id="submitButton" onclick="submitBuildRequest()">
                Send Build Request
            </button>

            <div id="responseDisplay" style="display: none; margin-top: 1.5rem; margin-bottom: 0;">
                <h3>Response:</h3>
                <div class="response-display" id="responseContent"></div>
            </div>
        </div>

            </div>

            <div class="dash-col">
        <!-- Live Pipeline Card (queue + active build status) -->
        <div class="card">
            <h2 class="card-title">
                <div class="card-title-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></div>
                Live Pipeline
            </h2>

            <div class="pipeline-head">
                <div style="color: var(--text-secondary);" id="build-queue-summary">Loading...</div>
                <div class="status-controls">
                    <button class="control-btn" onclick="window.refreshBuildStatus && window.refreshBuildStatus()"
                            id="refreshStatusBtn" style="display: none;">
                        Refresh Status
                    </button>
                    <button class="control-btn" onclick="window.toggleBuilderLog && window.toggleBuilderLog()"
                            id="tailBuilderLogBtn" style="display: none;">
                        View Builder Log
                    </button>
                </div>
            </div>

            <div id="build-queue-items" class="queue-list"></div>

            <div id="statusMonitorHint" style="display: none; margin-bottom: 1rem; color: var(--text-secondary); font-size: 0.9rem;"></div>

            <div id="statusMonitor">
                <p style="color: var(--text-secondary);">No active builds. Submit a request to start monitoring.</p>
            </div>

            <!-- Log tail container (initially hidden) -->
            <div id="logTailContainer" style="display: none; margin-top: 1rem; border-top: 1px solid var(--border); padding-top: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <h3 style="margin: 0; font-size: 1rem; color: var(--text-secondary);" id="builderLogTitle">Builder Log</h3>
                    <div style="display: flex; gap: 0.5rem;">
                        <button class="control-btn" onclick="clearBuilderLog()" style="padding: 2px 8px; font-size: 0.8rem;">Clear</button>
                        <button class="control-btn" onclick="window.toggleBuilderLog()" style="padding: 2px 8px; font-size: 0.8rem;">Close</button>
                    </div>
                </div>
                <div class="log-shell" id="builderLogShell">
                    <button type="button" class="log-expand-btn" id="builderLogExpandBtn"
                            onclick="openLogLightbox()" title="Expand log" aria-label="Expand log to full screen">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M16 3h3a2 2 0 0 1 2 2v3"/><path d="M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
                    </button>
                    <pre id="builderLogArea" class="log-area"></pre>
                </div>
            </div>
        </div>

        <!-- Recent Reports Card -->
        <div class="card">
            <h2 class="card-title">
                <div class="card-title-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1.4" fill="currentColor" stroke="none"/><circle cx="3.5" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="3.5" cy="18" r="1.4" fill="currentColor" stroke="none"/></svg></div>
                Recent Test Reports
            </h2>
            
            <div class="reports-section">
                <div class="reports-controls">
                    <button class="control-btn" onclick="refreshReports()">Refresh</button>
                    <button class="control-btn" onclick="viewAllReports()">View All Reports</button>
                </div>
                
                <div id="recentReports">
                    <div class="spinner"></div>
                </div>
            </div>
        </div>
            </div>
        </div>
    </div>

    <!-- System Info Modal -->
    <div class="modal" id="systemInfoModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">System Information</h2>
                <div class="modal-close" onclick="closeSystemInfo()">×</div>
            </div>
            
            <div class="info-section">
                <h3 class="info-title">Builder Configuration</h3>
                <div class="info-grid" id="builderInfo">
                    <div class="spinner"></div>
                </div>
            </div>

            <div class="info-section">
                <h3 class="info-title">Tester Configuration</h3>
                <div class="form-group">
                    <label class="form-label">Tester IP Address</label>
                    <input type="text" class="form-input" id="testerIp" 
                        placeholder="Enter tester IP to check status">
                    <button class="control-btn" style="margin-top: 0.5rem;" 
                        onclick="checkTesterStatus()">Check Status</button>
                </div>
                <div class="info-grid" id="testerInfo" style="margin-top: 1rem;">
                    <p style="color: var(--text-secondary);">Enter tester IP to view configuration</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Builder log lightbox: the live <pre> is moved in here while open, so the
         tail keeps writing to the same element and no content has to be mirrored. -->
    <div class="log-lightbox" id="logLightbox" hidden role="dialog" aria-modal="true" aria-labelledby="logLightboxTitle">
        <div class="log-lightbox-panel" id="logLightboxPanel">
            <div class="log-lightbox-head">
                <h3 class="log-lightbox-title" id="logLightboxTitle">Builder Log</h3>
                <button type="button" class="log-lightbox-close" onclick="closeLogLightbox()" aria-label="Close">&times;</button>
            </div>
            <div class="log-lightbox-body" id="logLightboxBody"></div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="/js/dashboard.js?v=<%= assetVersion %>"></script>
</body>
</html>
