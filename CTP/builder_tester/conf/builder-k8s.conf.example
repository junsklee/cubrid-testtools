# Example Kubernetes-enabled Builder Configuration
# This configuration enables Kubernetes mode for the builder service

# Server configuration
listen_port=8089
max_concurrent_builds=4

# Source directories
cubrid_src_dir=~/cubrid
shell_tc_dir=~/cubrid-testcases-private-ex
shell_tc_branch=develop

# Build configuration
build_arg=-g ninja -m debug build
build_dir=build_x86_64_debug

# Working directory
work_dir=/tmp/builder_work

# Tester service configuration
tester_port=8090

# Docker configuration (fallback when K8s unavailable)
use_docker=true
use_prebuilt_docker_images=true
docker_build_image=cubridci/cubridci:develop
docker_test_image=cubridci/cubridci:test_shell
keep_failed_containers=false

# Build timeout (minutes)
build_timeout_minutes=180

# Build cache configuration
build_cache_size=20

# Log management configuration
max_request_logs=5
max_tar_files=10
enable_request_grouping=true

# ===== KUBERNETES CONFIGURATION =====

# Enable Kubernetes mode
kubernetes.enabled=true

# Kubernetes cluster configuration
kubernetes.namespace=cubrid-testing
# kubernetes.context=production-cluster
# kubernetes.kubeconfig=~/.kube/config

# Resource limits for build jobs
kubernetes.build.cpu.request=2
kubernetes.build.cpu.limit=4
kubernetes.build.memory.request=4Gi
kubernetes.build.memory.limit=8Gi

# Resource limits for test jobs  
kubernetes.test.cpu.request=1
kubernetes.test.cpu.limit=2
kubernetes.test.memory.request=2Gi
kubernetes.test.memory.limit=4Gi

# Node selection - label nodes with these to control placement
kubernetes.nodeSelector.cubrid-testing=enabled
# kubernetes.build.nodeSelector.workload=build
# kubernetes.test.nodeSelector.workload=test

# Job configuration
kubernetes.job.backoffLimit=3
kubernetes.job.ttlSecondsAfterFinished=3600
kubernetes.job.activeDeadlineSeconds=7200
kubernetes.test.job.activeDeadlineSeconds=1800

# Scaling and load balancing
kubernetes.loadBalancing=RoundRobin
kubernetes.preferLocalNode=false
kubernetes.enableAntiAffinity=true
kubernetes.maxJobsPerNode=4

# Storage configuration
kubernetes.build.pvc=cubrid-build-pvc
kubernetes.test.pvc=cubrid-test-pvc
kubernetes.storageClass=standard

# Container images
kubernetes.build.image=cubridci/cubridci:develop
kubernetes.test.image=cubridci/cubridci:test_shell
kubernetes.imagePullPolicy=IfNotPresent
# kubernetes.imagePullSecret=my-registry-secret
