#!/bin/bash
#
# Pre-commit hook for CTP Builder-Tester
# Runs test suite before allowing commits
#
# Installation:
#   cp tests/pre-commit.hook .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running CTP Builder-Tester test suite...${NC}"

# Change to project root
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT/CTP/builder_tester" || exit 1

# Check if tests directory exists
if [[ ! -d "tests" ]]; then
    echo -e "${RED}Error: Test suite not found${NC}"
    echo "Expected location: $PROJECT_ROOT/CTP/builder_tester/tests"
    exit 1
fi

# Run tests in quiet mode for cleaner output
cd tests
./run_tests.sh -q

# Check test result
if [[ $? -eq 0 ]]; then
    echo -e "${GREEN}✓ All tests passed${NC}"
    echo "Proceeding with commit..."
    exit 0
else
    echo -e "${RED}✗ Tests failed${NC}"
    echo "Please fix failing tests before committing."
    echo ""
    echo "To see detailed test output, run:"
    echo "  cd tests && ./run_tests.sh -v"
    echo ""
    echo "To bypass this check (not recommended), use:"
    echo "  git commit --no-verify"
    exit 1
fi